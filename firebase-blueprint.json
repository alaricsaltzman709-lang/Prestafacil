{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "businessName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "bankBalance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Loan": {
      "title": "Loan",
      "description": "Loan record details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "borrowerName": { "type": "string" },
        "amount": { "type": "number" },
        "interestRate": { "type": "number" },
        "termMonths": { "type": "integer" },
        "startDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "paid", "defaulted"] },
        "totalPayable": { "type": "number" },
        "monthlyInstallment": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "borrowerName", "amount", "interestRate", "termMonths", "status", "createdAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Information about a specific payment installment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loanId": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentDate": { "type": "string", "format": "date-time" },
        "installmentNumber": { "type": "integer" },
        "notes": { "type": "string" }
      },
      "required": ["loanId", "userId", "amount", "paymentDate", "installmentNumber"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Borrower contact information",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "idNumber": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "createdAt"]
    },
    "AppSettings": {
      "title": "App Settings",
      "description": "Global application branding and configuration",
      "type": "object",
      "properties": {
        "appName": { "type": "string" },
        "logoUrl": { "type": "string" },
        "primaryFont": { "type": "string" },
        "fontSize": { "type": "string", "enum": ["small", "medium", "large"] },
        "primaryIconSet": { "type": "string" }
      },
      "required": ["appName"]
    },
    "UsernameMap": {
      "title": "Username Mapping",
      "description": "Public mapping of usernames to emails for login purposes",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["email", "uid"]
    },
    "LoanTable": {
      "title": "Loan Table",
      "description": "Customizable loan payment tables for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "frequency": { "type": "string", "enum": ["weekly", "biweekly", "monthly"] },
        "interestRate": { "type": "number" },
        "installments": { "type": "integer" },
        "rows": { 
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "amount": { "type": "number" },
              "installmentAmount": { "type": "number" },
              "totalAmount": { "type": "number" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "frequency", "interestRate", "installments", "rows", "createdAt"]
    }
  },
  "firestore": {
    "/config/app": {
      "schema": "AppSettings",
      "description": "Global app configuration"
    },
    "/usernames/{username}": {
      "schema": "UsernameMap",
      "description": "Public username to email mapping"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer profiles"
    },
    "/loans/{loanId}": {
      "schema": "Loan",
      "description": "Loan records"
    },
    "/loan_tables/{tableId}": {
      "schema": "LoanTable",
      "description": "Custom user loan tables"
    },
    "/loans/{loanId}/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payments for a specific loan"
    }
  }
}
