rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /_connection_test_/{docId} {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 100
        && (!('bankBalance' in data) || data.bankBalance is number)
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 100))
        && data.createdAt is timestamp;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['userId', 'name', 'createdAt'])
        && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('idNumber' in data) || (data.idNumber is string && data.idNumber.size() <= 50))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('address' in data) || (data.address is string && data.address.size() <= 500))
        && data.createdAt is timestamp;
    }

    function isValidLoan(data) {
      return data.keys().hasAll(['userId', 'borrowerName', 'amount', 'interestRate', 'termMonths', 'status', 'createdAt'])
        && data.userId == request.auth.uid
        && data.borrowerName is string && data.borrowerName.size() > 0 && data.borrowerName.size() <= 100
        && data.amount is number && data.amount > 0
        && data.interestRate is number && data.interestRate >= 0
        && data.termMonths is number && data.termMonths > 0
        && data.status in ['active', 'paid', 'defaulted']
        && (!('monthlyInstallment' in data) || data.monthlyInstallment is number)
        && (!('totalPayable' in data) || data.totalPayable is number)
        && (!('remainingBalance' in data) || data.remainingBalance is number)
        && data.createdAt is timestamp;
    }

    function isValidPayment(data, loanId) {
      return data.keys().hasAll(['userId', 'loanId', 'amount', 'paymentDate', 'installmentNumber', 'createdAt'])
        && data.userId == request.auth.uid
        && data.loanId == loanId
        && data.amount is number && data.amount > 0
        && data.paymentDate is timestamp
        && data.installmentNumber is number
        && data.createdAt is timestamp;
    }

    // Collection matches
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) 
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'businessName', 'bankBalance'])
        && isValidUserProfile(incoming());
    }

    match /customers/{customerId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidCustomer(incoming()) && isValidId(customerId);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid 
        && incoming().userId == existing().userId
        && isValidCustomer(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /loans/{loanId} {
      allow read: if isOwner(existing().userId);
      allow create: if isSignedIn() && isValidLoan(incoming()) && isValidId(loanId);
      allow update: if isOwner(existing().userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'remainingBalance', 'totalPayable', 'monthlyInstallment'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['borrowerName', 'amount', 'interestRate', 'termMonths'])
        )
        && isValidLoan(incoming());
      allow delete: if isOwner(existing().userId);

      match /payments/{paymentId} {
        allow read: if isOwner(get(/databases/$(database)/documents/loans/$(loanId)).data.userId);
        allow create: if isOwner(get(/databases/$(database)/documents/loans/$(loanId)).data.userId)
          && isValidPayment(incoming(), loanId)
          && isValidId(paymentId);
        allow delete: if isOwner(get(/databases/$(database)/documents/loans/$(loanId)).data.userId);
      }
    }
  }
}
