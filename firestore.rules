rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /_connection_test_/{docId} {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin'; 
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // config/app matches
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // usernames mapping matches
    match /usernames/{username} {
      allow read: if true;
      // Creation/Update handled by admin or on user registration
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == incoming().uid);
    }
    
    // Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && (data.uid == request.auth.uid || isAdmin())
        && data.email is string && data.email.size() <= 100
        && (!('role' in data) || data.role in ['admin', 'user'])
        && (!('bankBalance' in data) || data.bankBalance is number)
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 100))
        && data.createdAt is timestamp;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['userId', 'name', 'createdAt'])
        && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('idNumber' in data) || (data.idNumber is string && data.idNumber.size() <= 50))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('address' in data) || (data.address is string && data.address.size() <= 500))
        && data.createdAt is timestamp;
    }

    function isValidLoan(data) {
      return data.keys().hasAll(['userId', 'borrowerName', 'amount', 'interestRate', 'installments', 'paymentFrequency', 'installmentAmount', 'totalPayable', 'remainingBalance', 'status', 'createdAt'])
        && data.userId == request.auth.uid
        && data.borrowerName is string && data.borrowerName.size() > 0 && data.borrowerName.size() <= 100
        && data.amount is number && data.amount > 0
        && data.interestRate is number && data.interestRate >= 0
        && data.installments is number && data.installments > 0
        && data.paymentFrequency in ['weekly', 'biweekly', 'monthly']
        && data.installmentAmount is number && data.installmentAmount > 0
        && data.totalPayable is number && data.totalPayable > 0
        && data.remainingBalance is number
        && data.status in ['active', 'paid', 'defaulted']
        && data.createdAt is timestamp;
    }

    function isValidPayment(data, loanId) {
      return data.keys().hasAll(['userId', 'loanId', 'amount', 'paymentDate', 'installmentNumber', 'createdAt'])
        && data.userId == request.auth.uid
        && data.loanId == loanId
        && data.amount is number && data.amount > 0
        && data.paymentDate is timestamp
        && data.installmentNumber is number
        && data.createdAt is timestamp;
    }

    function isValidLoanTable(data) {
      return data.keys().hasAll(['userId', 'title', 'frequency', 'interestRate', 'installments', 'rows', 'createdAt'])
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.frequency in ['weekly', 'biweekly', 'monthly']
        && data.interestRate is number
        && data.installments is number
        && data.rows is list && data.rows.size() <= 100
        && data.createdAt is timestamp;
    }

    // Collection matches
    match /loan_tables/{tableId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidLoanTable(incoming()) && isValidId(tableId);
      allow update: if false; // Tables are immutable for now, delete and recreate
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) && isValidUserProfile(incoming());
      allow update: if (isOwner(userId) || isAdmin()) 
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (isAdmin() || incoming().get('role', 'user') == existing().get('role', 'user'))
        && isValidUserProfile(incoming());
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidCustomer(incoming()) && isValidId(customerId);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())
        && incoming().userId == existing().userId
        && isValidCustomer(incoming());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /loans/{loanId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidLoan(incoming()) && isValidId(loanId);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'remainingBalance', 'totalPayable', 'installmentAmount'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['borrowerName', 'amount', 'interestRate', 'installments', 'paymentFrequency'])
        )
        && isValidLoan(incoming());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      match /payments/{paymentId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/loans/$(loanId)).data.userId == request.auth.uid || isAdmin());
        allow create: if isSignedIn() && (get(/databases/$(database)/documents/loans/$(loanId)).data.userId == request.auth.uid || isAdmin())
          && isValidPayment(incoming(), loanId)
          && isValidId(paymentId);
        allow delete: if isSignedIn() && (get(/databases/$(database)/documents/loans/$(loanId)).data.userId == request.auth.uid || isAdmin());
      }
    }
  }
}
